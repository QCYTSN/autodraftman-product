[Unit]
Description=FigFox original SAM3 bridge
After=network.target

[Service]
Type=simple
User=figfox
Group=figfox
WorkingDirectory=/var/lib/figfox
EnvironmentFile=/etc/figfox/runtime.env
ExecStart=/opt/figfox/runtime/sam/bin/python /opt/figfox/current/scripts/cloud/sam-bridge.py --host 127.0.0.1 --port 18080
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/figfox

[Install]
WantedBy=multi-user.target
