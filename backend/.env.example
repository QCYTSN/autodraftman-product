AUTODRAFTMAN_ENVIRONMENT=development
AUTODRAFTMAN_DATABASE_URL=postgresql+asyncpg://autodraftman:autodraftman@localhost:5432/autodraftman
AUTODRAFTMAN_DATABASE_POOL_SIZE=10
AUTODRAFTMAN_DATABASE_MAX_OVERFLOW=20
AUTODRAFTMAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://qcytsn.github.io
AUTODRAFTMAN_COOKIE_SECURE=false
AUTODRAFTMAN_COOKIE_SAMESITE=lax
AUTODRAFTMAN_GUEST_TTL_DAYS=7
AUTODRAFTMAN_GUEST_CONTENT_TTL_DAYS=7
AUTODRAFTMAN_GUEST_INITIAL_CREDITS=1
AUTODRAFTMAN_SESSION_TTL_DAYS=30
AUTODRAFTMAN_ASSET_DELETE_GRACE_HOURS=24
AUTODRAFTMAN_ACCOUNT_PURGE_DAYS=30
AUTODRAFTMAN_BACKUP_RETENTION_DAYS=30
AUTODRAFTMAN_FRONTEND_URL=http://127.0.0.1:5173
# Set this to the public HTTPS API origin behind a reverse proxy.
AUTODRAFTMAN_PUBLIC_API_URL=
AUTODRAFTMAN_OAUTH_ATTEMPT_TTL_MINUTES=10

# Register separate OAuth apps for development and production.
# Leave both values empty to keep a provider disabled and hidden in the UI.
AUTODRAFTMAN_OAUTH_GOOGLE_CLIENT_ID=
AUTODRAFTMAN_OAUTH_GOOGLE_CLIENT_SECRET=
AUTODRAFTMAN_OAUTH_GITHUB_CLIENT_ID=
AUTODRAFTMAN_OAUTH_GITHUB_CLIENT_SECRET=

# Local Compose uses MinIO. The API calls the internal endpoint while presigned
# browser URLs use the public endpoint. Replace both values in shared environments.
AUTODRAFTMAN_S3_ENDPOINT_URL=http://localhost:9000
AUTODRAFTMAN_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AUTODRAFTMAN_S3_REGION=us-east-1
AUTODRAFTMAN_S3_BUCKET=autodraftman
AUTODRAFTMAN_S3_ACCESS_KEY_ID=autodraftman
AUTODRAFTMAN_S3_SECRET_ACCESS_KEY=autodraftman-local-only
AUTODRAFTMAN_S3_PRESIGN_TTL_SECONDS=600
AUTODRAFTMAN_ASSET_MAX_UPLOAD_BYTES=10485760
AUTODRAFTMAN_ASSET_MAX_PIXELS=40000000
